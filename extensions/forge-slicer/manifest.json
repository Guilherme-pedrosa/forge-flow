{
  "manifest_version": 3,
  "name": "Forge • Fatiador local",
  "version": "1.0.1",
  "description": "Fatia STL/3MF no Bambu Studio local somente quando você solicitar no Forge.",
  "minimum_chrome_version": "105",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Forge • Fatiador local"
  },
  "externally_connectable": {
    "matches": [
      "https://elevare3d.lovable.app/*",
      "https://id-preview--f4da8107-e6b0-434d-90a9-de1c21edf12f.lovable.app/*",
      "https://elevare3d.com.br/*"
    ]
  }
}
